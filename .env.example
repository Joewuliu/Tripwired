# Copy to .env (git-ignored) and fill in. Names only here; never commit values.

# Photon / Spectrum iMessage line (gateway)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini (explainer, screenshot and QR reading)
GEMINI_API_KEY=

# Threat feeds (analyzer). A missing key is reported as "not checked".
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Where the gateway reaches the analyzer (default http://127.0.0.1:8001)
ANALYZER_URL=

# The address behind the "Full report" line in a reply, e.g. https://34-123-45-67.sslip.io
# (docker-compose.yml sets it from SITE_HOST on the VM; leave empty to send no report line)
PUBLIC_URL=

# VM ONLY: the public hostname Caddy serves, e.g. 34-123-45-67.sslip.io (deploy/DEPLOY.md sets it)
SITE_HOST=

# VM ONLY: browsers running at once, 1 to 6 (default 3). On a small VM try 2 and compare live_check runs.
TRIPWIRE_BROWSERS=

# VM ONLY: allows the evaluation harness to open live phishing pages. Never set on a laptop.
TRIPWIRE_EVAL_OK=
