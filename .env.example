# Copy to .env (git-ignored) and fill in. Names only here; never commit values.

# Photon / Spectrum iMessage line (gateway)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Gemini (explainer, screenshot and QR reading)
GEMINI_API_KEY=

# Threat feeds (analyzer). A missing key is reported as "not checked".
SAFE_BROWSING_API_KEY=
URLHAUS_AUTH_KEY=

# Where the gateway reaches the analyzer (default http://localhost:8001)
ANALYZER_URL=

# VM ONLY: allows the evaluation harness to open live phishing pages. Never set on a laptop.
TRIPWIRE_EVAL_OK=
