# HTTPS front door. SITE_HOST is a hostname such as 34-123-45-67.sslip.io; Caddy gets and renews
# its certificate by itself.
#
# Only what a visitor needs is forwarded to the analyzer. POST /analyze is NOT: the gateway reaches
# it over the private network. The one public way to start a scan is /api/check, a separate route
# that takes a single address and is rate-limited by the analyzer. The built report site (the
# /r/<id> page, the home page and its paste-a-link box) is served from /srv/web, which
# deploy/caddy.Dockerfile puts in this image. Later steps add the event stream (/events, with
# flush_interval -1) here, one handle block each.
{$SITE_HOST} {
	encode gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
		-Server
	}

	# Sandbox screenshots. The analyzer itself accepts only 12-hex ids and answers 404 otherwise.
	handle /shots/*.png {
		reverse_proxy analyzer:8001
	}

	# The picture a shared report link shows (og:image), by the report's 12-hex id. Read-only: the
	# analyzer answers GET only, draws each picture once and keeps it.
	handle /og/*.png {
		reverse_proxy analyzer:8001
	}

	# Link previews. Programs that build a preview (Messages, Slack, and the like) do not run the web
	# app's scripts, so for a report or its card they are given the analyzer's small page of Open
	# Graph tags instead. Only a 12-hex id and a known preview program match; everyone else, and
	# every other address, gets the web app below.
	@preview {
		path_regexp report ^/r/([a-f0-9]{12})(/card)?/?$
		header_regexp User-Agent (?i)(facebookexternalhit|facebot|twitterbot|slackbot|discordbot|whatsapp|telegrambot|linkedinbot|skypeuripreview|iframely|embedly)
	}
	handle @preview {
		rewrite * /share/{re.report.1}
		reverse_proxy analyzer:8001
	}

	# A finished scan's report, as JSON, by its 12-hex id (what the report page fetches). The
	# analyzer's route is GET-only, so it answers 405 to anything else, and 404 to an unknown id.
	handle /api/report/* {
		reverse_proxy analyzer:8001
	}

	# The paste-a-link box: one address in, a report id out. The analyzer rate-limits it using the
	# client address Caddy puts in X-Forwarded-For. A scan can take up to about 30 seconds.
	handle /api/check {
		reverse_proxy analyzer:8001
	}

	# The live event stream (Server-Sent Events), read-only: GET only, one event per step of every
	# scan, addresses defanged and senders masked (•••-4412). flush_interval -1 sends each event as
	# it happens; Content-Encoding is set so the gzip above leaves the stream alone. The dashboard
	# is served from this same host, so no other origin is allowed to read it from a page.
	@events {
		path /events
		method GET
	}
	handle @events {
		reverse_proxy analyzer:8001 {
			flush_interval -1
			header_down Content-Encoding identity
		}
	}
	handle /events {
		respond "Method not allowed" 405
	}

	# Anything else under /api, and the routes the gateway uses over the private network, are not
	# public: answer 404 here rather than letting them fall through to the web app.
	handle /api/* {
		respond "Not found" 404
	}
	handle /analyze {
		respond "Not found" 404
	}
	handle /read-image {
		respond "Not found" 404
	}
	handle /internal/* {
		respond "Not found" 404
	}

	# The built web app. Unknown paths such as /r/<id> get index.html and the page routes itself.
	handle {
		root * /srv/web
		header Cache-Control "no-cache"
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
